#!/bin/bash
# FedDeck Installer - ML4W-style dotfiles installer
# Safe profile management with automated backups and symlinking

set -e

# ======================================
# CONFIGURATION
# ======================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE_ID="com.feddeck"
TARGET_DIR="$HOME/.feddeck"
BACKUP_DIR="$HOME/.feddeck-backup"
PROFILE_CONFIG="$HOME/.config/feddeck-installer"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ======================================
# UTILITIES
# ======================================
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# ======================================
# BACKUP FUNCTIONS
# ======================================
create_backup() {
    local timestamp=$(date +%Y%m%d-%H%M%S)
    local backup_path="$BACKUP_DIR/$timestamp"

    log_info "Creating backup at $backup_path"
    mkdir -p "$backup_path"

    # Backup existing dotfiles
    for item in .config/hypr .config/quickshell .config/theme; do
        if [ -e "$HOME/$item" ]; then
            log_info "Backing up $HOME/$item"
            cp -r "$HOME/$item" "$backup_path/" 2>/dev/null || true
        fi
    done

    log_success "Backup created"
}

# ======================================
# SYMLINK FUNCTIONS
# ======================================
safe_symlink() {
    local source="$1"
    local target="$2"

    # Create target directory if needed
    local target_dir=$(dirname "$target")
    mkdir -p "$target_dir"

    # Check if target exists
    if [ -e "$target" ] || [ -L "$target" ]; then
        # Check if it's already a symlink to our source
        if [ -L "$target" ] && [ "$(readlink -f "$target")" = "$(readlink -f "$source")" ]; then
            log_info "Already symlinked: $target"
            return
        fi

        # Backup existing file
        log_warning "Backing up existing: $target"
        mv "$target" "$target.backup-$(date +%Y%m%d-%H%M%S)"
    fi

    # Create symlink
    log_info "Symlinking: $source -> $target"
    ln -s "$source" "$target"
}

# ======================================
# INSTALLATION FUNCTIONS
# ======================================
install_dotfiles() {
    log_info "Installing dotfiles to $TARGET_DIR"

    # Create target directory
    mkdir -p "$TARGET_DIR"

    # Copy dotfiles to target (safe sandbox approach)
    if [ -d "$SCRIPT_DIR/desktop" ]; then
        log_info "Copying desktop configuration"
        cp -r "$SCRIPT_DIR/desktop"/* "$TARGET_DIR/"
    fi

    # Create symlinks
    log_info "Creating symlinks"

    # Hyprland config
    if [ -d "$TARGET_DIR/hyprland" ]; then
        safe_symlink "$TARGET_DIR/hyprland" "$HOME/.config/hypr"
    fi

    # Quickshell config
    if [ -d "$TARGET_DIR/quickshell" ]; then
        safe_symlink "$TARGET_DIR/quickshell" "$HOME/.config/quickshell"
    fi

    # Theme config
    if [ -d "$TARGET_DIR/theming" ]; then
        safe_symlink "$TARGET_DIR/theming" "$HOME/.config/theme"
    fi

    log_success "Dotfiles installed"
}

# ======================================
# SETUP SCRIPTS
# ======================================
run_setup_scripts() {
    log_info "Running setup scripts"

    # Preflight
    if [ -f "$SCRIPT_DIR/setup/preflight.sh" ]; then
        log_info "Running preflight checks"
        bash "$SCRIPT_DIR/setup/preflight.sh"
    fi

    if [ -f "$SCRIPT_DIR/setup/preflight-fedora.sh" ]; then
        log_info "Running Fedora-specific preflight"
        bash "$SCRIPT_DIR/setup/preflight-fedora.sh"
    fi

    # Dependencies
    if [ -f "$SCRIPT_DIR/setup/dependencies/packages-fedora" ]; then
        log_info "Installing dependencies"
        bash "$SCRIPT_DIR/setup/dependencies/packages-fedora"
    fi

    # Post-install
    if [ -f "$SCRIPT_DIR/setup/post.sh" ]; then
        log_info "Running post-installation tasks"
        bash "$SCRIPT_DIR/setup/post.sh"
    fi

    if [ -f "$SCRIPT_DIR/setup/post-fedora.sh" ]; then
        log_info "Running Fedora-specific post-installation"
        bash "$SCRIPT_DIR/setup/post-fedora.sh"
    fi

    log_success "Setup scripts completed"
}

# ======================================
# MAIN INSTALLATION
# ======================================
main() {
    echo "========================================"
    echo "  FedDeck Installer"
    echo "========================================"
    echo ""

    # Check if running as user
    if [ "$EUID" -eq 0 ]; then
        log_error "Do not run as root"
        exit 1
    fi

    # Create backup
    create_backup

    # Run setup scripts
    run_setup_scripts

    # Install dotfiles
    install_dotfiles

    echo ""
    log_success "Installation complete!"
    echo ""
    echo "Next steps:"
    echo "1. Reboot your system"
    echo "2. Log in via SDDM (Hyprland session)"
    echo "3. The custom shell will start automatically"
    echo ""
    echo "Backup location: $BACKUP_DIR"
    echo "Dotfiles location: $TARGET_DIR"
}

# Run main
main "$@"
